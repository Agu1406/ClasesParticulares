<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejercicio 9: SQLite - Conceptos"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/buttonCrearBD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Crear base de datos"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/buttonMostrarInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mostrar información de BD"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/buttonEliminarBD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Eliminar base de datos"
        android:backgroundTint="@android:color/holo_red_dark"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/textViewInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Presiona 'Crear base de datos' para comenzar"
            android:padding="12dp"
            android:background="@android:color/black"
            android:textColor="@android:color/white"
            android:fontFamily="monospace" />

    </ScrollView>

</LinearLayout>

