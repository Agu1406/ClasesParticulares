<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- StackPane centra su contenido en horizontal y vertical -->
<StackPane minHeight="340.0" minWidth="320.0" prefHeight="340.0" prefWidth="320.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ev1.ut3_stringsyenvolventes.teoria.U01_StringsYEnvolventesController">
   <children>
      <VBox alignment="CENTER" spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <TextField fx:id="campoTexto" prefWidth="260.0" text="  hola DAM  " />
            <Button mnemonicParsing="false" onAction="#onMayusculasClick" text="toUpperCase()" />
            <Button mnemonicParsing="false" onAction="#onLongitudClick" text="length()" />
            <Button mnemonicParsing="false" onAction="#onTrimClick" text="trim()" />
            <Button mnemonicParsing="false" onAction="#onParseIntClick" text="Integer.parseInt()" />
            <Label fx:id="lblResultado" alignment="CENTER" maxWidth="260.0" text="Resultado: —" wrapText="true" />
         </children>
      </VBox>
   </children>
</StackPane>
