<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- StackPane centra su contenido en horizontal y vertical -->
<StackPane minHeight="280.0" minWidth="340.0" prefHeight="280.0" prefWidth="340.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ev1.ut2_controlflujometodos.teoria.U01_CondicionalesYMetodosController">
   <children>
      <VBox alignment="CENTER" spacing="12.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <TextField fx:id="campoNumero" prefWidth="280.0" promptText="Escribe un entero" text="7" />
            <Button mnemonicParsing="false" onAction="#onComprobarParidadClick" text="Comprobar par / impar" />
            <Label fx:id="lblParidad" alignment="CENTER" maxWidth="280.0" text="Paridad: —" wrapText="true" />
            <Button mnemonicParsing="false" onAction="#onIncrementarClick" text="Incrementar contador" />
            <Label fx:id="lblContador" text="Contador: 0" />
         </children>
      </VBox>
   </children>
</StackPane>
